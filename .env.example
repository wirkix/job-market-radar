# --- Postgres (warehouse) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=job_market_radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me

# Second database created in the same Postgres instance, used only for
# Airflow's own metadata (DAG runs, task state) — separate from the
# warehouse database above on purpose, so `raw`/`staging`/`marts` schemas
# stay uncluttered by Airflow's internal tables.
AIRFLOW_DB=airflow

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_EMAIL=alois.wirkes@gmail.com

# --- Scraper ---
SCRAPER_USER_AGENT=JobMarketRadarBot/1.0 (+https://github.com/wirkix/job-market-radar; portfolio project, respects robots.txt)
SCRAPER_CRAWL_DELAY_SECONDS=2

# --- LLM enrichment (pick one) ---
# provider = "anthropic" or "ollama". Defaulting to ollama: $0, fully local,
# no API key. Switch to "anthropic" for better extraction quality if you're
# willing to spend the (tiny — fractions of a cent per posting with Haiku)
# API cost.
ENRICHMENT_PROVIDER=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
